# Root-context Compose builds intentionally send only reproducible inputs.
# Keep private .env/secrets, keystores, uploads, SDKs, build output and QA captures
# out of the build context. Railway's subdirectory contexts are unchanged.
**
!package.json
!package-lock.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/src/
!apps/api/src/**
!apps/api/data/
!apps/api/data/**
!apps/web/
!apps/web/package.json
!apps/web/index.html
!apps/web/vite.config.js
!apps/web/nginx.conf
!apps/web/src/
!apps/web/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/shared/
!packages/shared/package.json
!packages/shared/src/
!packages/shared/src/**
!infra/
!infra/docker/
!infra/docker/Dockerfile
