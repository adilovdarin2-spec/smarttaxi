NODE_ENV=production

POSTGRES_DB=smarttaxi
POSTGRES_USER=smarttaxi
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
DATABASE_URL=postgresql://smarttaxi:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5434/smarttaxi
API_DATABASE_URL=postgresql://smarttaxi:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/smarttaxi

REDIS_URL=redis://127.0.0.1:6379
API_REDIS_URL=redis://redis:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET_FOR_PRODUCTION
# Reserved for future token split. Current API uses JWT_SECRET.
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_REFRESH_SECRET
JWT_EXPIRES_IN=365d

API_PORT=4000
WEB_PORT=5173
NPM_STRICT_SSL=true

# NOT USED IN PROD — Railway is the only live deployment (see
# docs/status/railway-domain-setup-2026-07-15.md); api.smarttaxi.kz below is
# the old VPS/nginx target (infra/nginx/, docker-compose.yml), kept in the
# repo but not currently pointed at anything live. Once a custom domain is
# attached to Railway, point these there instead.
API_ORIGIN=https://api.smarttaxi.kz
APP_ORIGIN=https://app.smarttaxi.kz
API_PUBLIC_URL=https://api.smarttaxi.kz
WEB_PUBLIC_URL=https://app.smarttaxi.kz
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5179,http://127.0.0.1:5179,https://app.smarttaxi.kz,https://smarttaxi.kz
RATE_LIMIT_ENABLED=true

MAPTILER_API_KEY=PASTE_MAPTILER_KEY_HERE
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/openstreetmap/style.json?key=${MAPTILER_API_KEY}
MAPTILER_GEOCODING_URL=https://api.maptiler.com/geocoding
VITE_MAPTILER_API_KEY=PASTE_MAPTILER_KEY_HERE
VITE_MAPTILER_STYLE_URL=https://api.maptiler.com/maps/openstreetmap/style.json?key=${MAPTILER_API_KEY}
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSRM_BASE_URL=http://osrm:5000
ROUTING_BASE_URL=http://osrm:5000
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION_TEXT=© OpenStreetMap contributors
MAP_SEARCH_PROVIDER=local_catalog_maptiler_photon_nominatim
MAP_REVERSE_PROVIDER=maptiler_nominatim_photon_local_fallback

# SMS provider. Use `dev` locally; use `infobip` on VPS/production.
SMS_PROVIDER=dev
SMS_FROM=ServiceSMS
SMS_DEV_MODE=false
SMS_DEV_CODE=111111
INFOBIP_BASE_URL=https://YOUR_INFOBIP_SUBDOMAIN.api.infobip.com
INFOBIP_API_KEY=PASTE_INFOBIP_APP_KEY_HERE

# Seed accounts. These values are published in this repository, so they are
# development defaults only — `npm run seed` refuses to run against a
# production database while any password below is still the default.
DEFAULT_ADMIN_EMAIL=admin@smarttaxi.local
DEFAULT_ADMIN_PASSWORD=ChangeMe_2026!
DEFAULT_DRIVER_PHONE=+77000000000
DEFAULT_DRIVER_PASSWORD=123456
DEFAULT_CLIENT_PASSWORD=123456
DEFAULT_FINANCE_PASSWORD=123456

# Push notifications (Firebase Cloud Messaging). Path to the Firebase Admin
# SDK service-account JSON (Firebase console -> Project settings -> Service
# accounts -> Generate new private key). Leave unset to disable push sending
# without affecting anything else (in-app notifications still work).
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Crash/error monitoring (Sentry). Leave unset to disable reporting entirely.
SENTRY_DSN=

CITY=Atakent
CURRENCY=KZT
CURRENCY_SYMBOL=₸
