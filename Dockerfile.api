# The API deployed from the monorepo root. Railway uploads the repository, so
# the build context is the root and every path here is repo-relative; the
# service-local apps/api/Dockerfile stays as it is for local builds.
FROM node:22-bookworm-slim
WORKDIR /app
ARG NPM_STRICT_SSL=true
RUN npm config set strict-ssl ${NPM_STRICT_SSL}
COPY apps/api/package*.json ./
RUN npm install --omit=dev --omit=optional
COPY apps/api/src ./src
# routing.service.js reaches five levels up for the shared building-selection
# helpers, which lands at /packages in the image rather than /app/packages.
# Without this the container starts and dies on the very first import.
COPY packages /packages
# The harvested address gazetteer. It has to ship inside the image: the
# container cannot reach Overpass, so this is the only way street-level
# addresses exist in production at all.
COPY apps/api/data ./data
EXPOSE 4000
CMD ["node", "src/server.js"]
