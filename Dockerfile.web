# The web app deployed from the monorepo root. Railway uploads the repository,
# so the build context is the root and every path here is repo-relative; the
# service-local apps/web/Dockerfile stays as it is for local builds.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
# Baked at build time: Vite inlines these, so the bundle is tied to one
# backend. A build for the public server must be given the public API.
ARG VITE_API_URL
ARG VITE_SOCKET_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL
COPY apps/web/package*.json ./
RUN npm install
COPY apps/web/ ./
# MapView.jsx reaches five levels up for the shared building-selection helpers,
# which lands at /packages in the image rather than /app/packages.
COPY packages /packages
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
